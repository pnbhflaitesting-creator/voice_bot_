# ============================================================================
#  Pick a provider for each stage. Mix and match freely.
#    STT_PROVIDER: openai | deepgram | elevenlabs
#    TTS_PROVIDER: openai | deepgram | elevenlabs
#    LLM_PROVIDER: gemini | openai
#  You only need the API keys for the providers you actually select.
# ============================================================================
STT_PROVIDER=openai
TTS_PROVIDER=openai
LLM_PROVIDER=gemini

# ---- API keys (only the selected providers' keys are required) ----
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=...
# DEEPGRAM_API_KEY=...
# ELEVENLABS_API_KEY=...

# ---- Speech-to-Text ----
# Pin the language you speak (ISO-639-1) — big accuracy + speed win. Empty=auto.
STT_LANGUAGE=en                       # en, sk, de, es, fr, ...
# STT_PROMPT=Acme Corp, Kubernetes     # OpenAI only: bias spelling of jargon
STT_MODEL=gpt-4o-mini-transcribe      # OpenAI STT model (AVOID whisper-1: slow)
# DEEPGRAM_STT_MODEL=nova-3            # Deepgram STT model
# ELEVENLABS_STT_MODEL=scribe_v1      # ElevenLabs (Scribe) STT model

# ---- Text-to-Speech ----
TTS_SPEED=1.0                         # OpenAI only: 1.0 normal, up to 4.0
TTS_MODEL=gpt-4o-mini-tts             # OpenAI: tts-1 = lowest latency
TTS_VOICE=alloy                       # OpenAI: alloy, echo, fable, onyx, nova, shimmer
# DEEPGRAM_TTS_MODEL=aura-2-thalia-en # Deepgram Aura voice (voice = model name)
# ELEVENLABS_TTS_MODEL=eleven_flash_v2_5   # Flash = lowest latency
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM # default = Rachel

# ---- LLM: Gemini ----
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL=gemini-2.0-flash         # flash-lite / 2.0-flash are fastest
# Gemini 2.5 models "think" by default (slow). "none" disables it for speed.
# Set empty if your endpoint rejects the reasoning_effort parameter.
GEMINI_REASONING_EFFORT=none

# ---- LLM: OpenAI (only if LLM_PROVIDER=openai) ----
# OPENAI_LLM_MODEL=gpt-4o-mini

# ---- LLM: shared ----
MAX_REPLY_TOKENS=200                   # cap reply length for responsiveness
# SYSTEM_PROMPT=You are a helpful, friendly voice assistant...

SHOW_TIMINGS=true                     # print per-turn stt/llm/tts latency

# ---- Audio devices (optional; run `python -m voice_bot --devices` to list) --
# INPUT_DEVICE=1
# OUTPUT_DEVICE=3

# ---- Voice activity / turn-taking tuning (optional) ----
# VAD_THRESHOLD=0.5           # 0..1, higher = less sensitive
# MIN_SPEECH_MS=200           # speech must last this long to start a turn
# SILENCE_HANGOVER_MS=500     # trailing silence that ends a turn (lower = snappier)
# MIN_TURN_MS=350             # ignore turns shorter than this
# SPEECH_PAD_MS=250           # keep this much audio before speech start
# ALLOW_INTERRUPTIONS=true    # barge-in (use headphones to avoid echo)
