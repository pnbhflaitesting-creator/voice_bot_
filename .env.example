# ---- OpenAI: used for Speech-to-Text and Text-to-Speech ----
OPENAI_API_KEY=sk-...
STT_MODEL=gpt-4o-mini-transcribe      # or whisper-1
# STRONGLY recommended: pin the language you speak (ISO-639-1). This fixes
# wrong-language transcriptions and makes STT faster. Leave empty for auto.
STT_LANGUAGE=en                       # en, sk, de, es, fr, ...
# Optional: bias spelling of names/jargon the model tends to get wrong.
# STT_PROMPT=Acme Corp, Kubernetes, Anaconda
TTS_MODEL=gpt-4o-mini-tts             # tts-1 = lowest latency; gpt-4o-mini-tts = nicer
TTS_VOICE=alloy                       # alloy, echo, fable, onyx, nova, shimmer
TTS_SPEED=1.0                         # 1.0 normal; up to 4.0 faster speech
SHOW_TIMINGS=true                     # print per-turn stt/llm/tts latency

# ---- Gemini: your existing LLM endpoint (OpenAI-compatible wire format) ----
GEMINI_API_KEY=...
# Google's compatibility endpoint is the default; point this at your own
# endpoint if you proxy Gemini yourself.
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL=gemini-2.0-flash

# System prompt shaping the assistant's voice/personality (optional).
# SYSTEM_PROMPT=You are a helpful, friendly voice assistant...

# ---- Audio devices (optional; run `python -m voice_bot --devices` to list) --
# INPUT_DEVICE=1
# OUTPUT_DEVICE=3

# ---- Voice activity / turn-taking tuning (optional) ----
# VAD_THRESHOLD=0.5           # 0..1, higher = less sensitive
# MIN_SPEECH_MS=200           # speech must last this long to start a turn
# SILENCE_HANGOVER_MS=500     # trailing silence that ends a turn (lower = snappier)
# MIN_TURN_MS=350             # ignore turns shorter than this
# SPEECH_PAD_MS=250           # keep this much audio before speech start
# ALLOW_INTERRUPTIONS=true    # barge-in (use headphones to avoid echo)
