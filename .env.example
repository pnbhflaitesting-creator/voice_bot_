# ============================================================================
#  Pick a provider for each stage. Mix and match freely.
#    STT_PROVIDER: openai | deepgram | deepgram-stream | elevenlabs
#    TTS_PROVIDER: openai | deepgram | elevenlabs
#    LLM_PROVIDER: gemini | openai
#  You only need the API keys for the providers you actually select.
#
#  deepgram-stream = real-time streaming STT: transcribes WHILE you talk over a
#  WebSocket, so there's almost nothing left to do when you stop (lowest STT
#  latency). Needs `pip install websockets`; falls back to batch if it can't
#  connect.
# ============================================================================
STT_PROVIDER=deepgram-stream
TTS_PROVIDER=deepgram
LLM_PROVIDER=gemini

# ---- API keys (only the selected providers' keys are required) ----
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=

# ---- Speech-to-Text ----
# Pin the language you speak (ISO-639-1) — big accuracy + speed win. Empty=auto.
STT_LANGUAGE=en                       # en, sk, de, es, fr, ...
# STT_PROMPT=Acme Corp, Kubernetes     # OpenAI only: bias spelling of jargon
STT_MODEL=gpt-4o-mini-transcribe      # OpenAI STT model (AVOID whisper-1: slow)
DEEPGRAM_STT_MODEL=nova-3            # Deepgram STT model
ELEVENLABS_STT_MODEL=scribe_v1      # ElevenLabs (Scribe) STT model

# ---- Text-to-Speech ----
TTS_SPEED=1.0                         # OpenAI only: 1.0 normal, up to 4.0
TTS_MODEL=gpt-4o-mini-tts             # OpenAI: tts-1 = lowest latency
TTS_VOICE=alloy                       # OpenAI: alloy, echo, fable, onyx, nova, shimmer
DEEPGRAM_TTS_MODEL=aura-2-thalia-en # Deepgram Aura voice (voice = model name)
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5   # Flash = lowest latency
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM # default = Rachel

# ---- LLM: Gemini ----
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL=gemini-2.5-flash-lite         # flash-lite / 2.0-flash are fastest
# Gemini 2.5 models "think" by default (slow). "none" disables it for speed.
# Set empty if your endpoint rejects the reasoning_effort parameter.
GEMINI_REASONING_EFFORT=none

# ---- LLM: OpenAI (only if LLM_PROVIDER=openai) ----
OPENAI_LLM_MODEL=gpt-4o-mini

# ---- LLM: shared ----
MAX_REPLY_TOKENS=400                   # reply length cap (raise for fuller answers)
TEMPERATURE=0.2                        # 0=deterministic, higher=more varied
GREETING=How can I help you today?     # spoken on startup (empty = no greeting)
# RESPONSE_LANGUAGE=English            # force replies into one language
# SYSTEM_PROMPT=You are a helpful, friendly voice assistant...

# ---- Agent (tool calling) ----
# Give the LLM tools: weather, time, calculator, web search, and session memory.
# It asks for missing details (e.g. a city for weather) instead of guessing.
# Requires a tool-capable model (Gemini 2.0/2.5 flash, gpt-4o-mini, etc).
# Multiple tool calls in one turn run in PARALLEL (e.g. several web searches).
AGENT_ENABLED=true

# ---- Web UI (python -m voice_bot --web) ----
WEB_HOST=127.0.0.1
WEB_PORT=8000

SHOW_TIMINGS=true                     # print per-turn stt/llm/tts latency

# ---- Logging (a fresh log file per session) ----
LOG_DIR=logs                          # folder for session_<timestamp>.log files
LOG_LEVEL=INFO                        # DEBUG for more detail
LOG_TO_CONSOLE=false                  # also echo log lines to the terminal

# ---- Debug recording ----
# Save each turn's raw audio, denoised audio (what STT receives), and transcript
# so you can listen to both and compare. Files: <time>_<n>_raw.wav / _clean.wav / .txt
SAVE_TURNS=false                      # true to record every turn
TURNS_DIR=recordings                  # output folder

# ---- Audio devices (optional; run `python -m voice_bot --devices` to list) --
# INPUT_DEVICE=1
# OUTPUT_DEVICE=3

# ---- Voice activity / turn-taking tuning (optional) ----
# Raise these two to stop background noise / other voices from TRIGGERING the bot:
VAD_THRESHOLD=0.7           # 0..1, higher = less sensitive (try 0.6-0.75 in noise)
MIN_SPEECH_MS=300           # speech must last this long to start a turn (try 300+)
SILENCE_HANGOVER_MS=500     # trailing silence that ends a turn (lower = snappier)
# MIN_TURN_MS=350             # ignore turns shorter than this
# SPEECH_PAD_MS=250           # keep this much audio before speech start
# Barge-in (interrupt the bot by speaking). REQUIRES that the mic does NOT hear
# the bot — use a headset whose mic is the input device, and make sure output
# goes ONLY to the headphones (no laptop speakers, no "Stereo Mix"/loopback
# input). If the bot interrupts itself, your mic is capturing its own audio:
# set this to false (half-duplex) or fix the input device.
ALLOW_INTERRUPTIONS=false
ECHO_GUARD_MS=400            # after bot starts talking, ignore barge-in this long

# ---- Noise suppression (optional; cleans the audio before STT) ----
# OFF by default: spectral denoise is CPU-heavy and adds ~0.5-2s PER TURN
# (it scales with clip length) and can muffle short utterances. Deepgram/OpenAI
# STT already handle moderate noise well. Turn this on only if a noisy room is
# clearly hurting transcription, and check the ⏱ "denoise" number.
# Needs: pip install noisereduce scipy
DENOISE=none                # none | spectral (spectral-gating denoise)
DENOISE_STRENGTH=0.8        # 0..1, higher removes more noise (can muffle speech)
# DENOISE_STATIONARY=false    # true = constant noise (fan/hum); false = adaptive
HIGHPASS_HZ=0                # e.g. 90 to cut low rumble/hum (0 = off)
